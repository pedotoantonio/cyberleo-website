# CyberLeo — Esempio di configurazione
# Copia questo file in `.env` e compila i valori reali.
# Il file `.env` NON va mai committato nel repository.

# Stringa di connessione PostgreSQL (obbligatoria)
DATABASE_URL=postgresql://utente:password@localhost:5432/nomedb

# Chiave segreta per i token JWT dell'area admin (obbligatoria in produzione)
JWT_SECRET=cambia-questa-chiave-con-un-valore-lungo-e-casuale

# Porta del backend (opzionale, default 8004)
PORT=8004

# Endpoint API Voxtral TTS (opzionale, default /api/tts)
# VITE_VOXTRAL_API_URL=/api/tts
